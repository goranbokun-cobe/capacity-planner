# Copy this file to .env and fill in the values.

# ── Database ────────────────────────────────────────────────────
DATABASE_URL="file:./prisma/dev.db"        # local SQLite
# DATABASE_URL="postgresql://..."          # for server mode (Postgres)

# ── Productive.io ───────────────────────────────────────────────
PRODUCTIVE_API_TOKEN=your_productive_api_token_here
PRODUCTIVE_ORG_ID=your_org_id_here

# ── Google OAuth (NextAuth) ─────────────────────────────────────
# Create credentials at console.cloud.google.com → APIs & Services → Credentials
# Type: Web application
# Authorised redirect URI: http://localhost:3000/api/auth/callback/google
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate_with__openssl_rand_-base64_32
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
